# -------------------------------------------------------------
# x2t Telegram Bot Configuration Template
# -------------------------------------------------------------

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuvWXyz

# Telegram MTProto API ID and Hash from my.telegram.org (For 2GB Direct Uploads)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Admin Telegram User IDs (comma-separated or JSON list)
ADMIN_IDS=[123456789]

# Path to SQLite database file
DB_PATH=bot_database.sqlite3

# Directory for temporary file downloads before sending
TEMP_DOWNLOAD_DIR=./downloads/temp_bot

# Anti-flood rate limit in seconds per user
RATE_LIMIT_SECONDS=2.0

# Optional: Twitter Auth Token for NSFW & Age-Restricted Profile Timelines
TWITTER_AUTH_TOKEN=your_auth_token_here
